# Copy to .env (gitignored). Never commit real values.
# PMX reads credentials from the environment only — nothing is stored in config files.

# --- Kalshi ---
# Key ID is a UUID shown in the Kalshi UI. The private key is a PEM file on disk;
# PMX takes the *path*, never the key material itself, so the key never enters config.
PMX_KALSHI_ENV=demo
PMX_KALSHI_KEY_ID=
PMX_KALSHI_PRIVATE_KEY_PATH=

# --- Polymarket ---
# L1 wallet key derives L2 API credentials. Keep the wallet funded with only what
# the risk config authorizes; the key is a total-loss vector no limit can constrain.
PMX_POLYMARKET_PRIVATE_KEY=
PMX_POLYMARKET_API_KEY=
PMX_POLYMARKET_API_SECRET=
PMX_POLYMARKET_API_PASSPHRASE=
PMX_POLYMARKET_CHAIN_ID=137

# --- Runtime ---
PMX_DB_PATH=var/pmx.db
PMX_RISK_CONFIG=risk_config.yaml
